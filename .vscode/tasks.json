{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run NexGoAI backend",
			"type": "shell",
			"command": ".venv/bin/python",
			"args": [
				"-m",
				"uvicorn",
				"backend.main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run NexGoAI backend (backend venv)",
			"type": "shell",
			"command": "backend/.venv/bin/python",
			"args": [
				"-m",
				"uvicorn",
				"backend.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}